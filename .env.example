GOOGLE_CREDS_JSON=

# YouGile CRM — https://ru.yougile.com/api-v2
# 1) Создайте ключ API в YouGile
# 2) python scripts/list_yougile.py → скопируйте YOUGILE_COLUMN_ID колонки «Новые»
YOUGILE_API_KEY=
YOUGILE_COLUMN_ID=
# Кому назначать заявки (id из GET /api-v2/users); пусто — без исполнителя
YOUGILE_ASSIGNEE_ID=
# REST API key from YouGile → Настройки → API (NOT the ygmcp_ MCP token)
YOUGILE_API_BASE=https://ru.yougile.com/api-v2

